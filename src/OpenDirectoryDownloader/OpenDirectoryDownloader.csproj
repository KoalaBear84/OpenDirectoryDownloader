<Project Sdk="Microsoft.NET.Sdk">

  <!-- The application: command line, hosting, the crawl engine and its protocols, outputs and the console -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Dynamic PGO instruments code before optimizing it; a scan is short and CPU heavy, and was up to 30% slower with it -->
    <TieredPGO>false</TieredPGO>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm;linux-arm64;osx-x64</RuntimeIdentifiers>
    <ApplicationIcon>Resources\Application.ico</ApplicationIcon>
    <!-- The site parsers' JSON models (Dufs, AList, PCloud, HFS, upload sites, ...) still use reflection based System.Text.Json -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <Optimize>False</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>True</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlareSolverrSharp" />
    <PackageReference Include="FluentFTP" />
    <PackageReference Include="HttpCloak" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Polly.Core" />
    <!--
      WARNING: PuppeteerSharp is pinned to 20.2.6 (Directory.Packages.props), do not update it.
      PuppeteerExtraSharp 3.1.1 (the latest) is built against PuppeteerSharp 20.2.2: from 21.0.0 on the methods it calls
      changed (IPage.EvaluateFunctionAsync / EvaluateExpressionAsync, and IBrowser.PagesAsync from 24.42.0), which only
      shows when the browser starts: MissingMethodException "Method not found: ... IBrowser.PagesAsync()".
      Only update PuppeteerSharp together with a PuppeteerExtraSharp that is built against that version.
    -->
    <PackageReference Include="PuppeteerExtraSharp" />
    <PackageReference Include="PuppeteerSharp" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="TextCopy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenDirectoryDownloader.Core\OpenDirectoryDownloader.Core.csproj" />
    <ProjectReference Include="..\OpenDirectoryDownloader.GoogleDrive\OpenDirectoryDownloader.GoogleDrive.csproj" />
    <ProjectReference Include="..\OpenDirectoryDownloader.Parsing\OpenDirectoryDownloader.Parsing.csproj" />
    <ProjectReference Include="..\OpenDirectoryDownloader.Server\OpenDirectoryDownloader.Server.csproj" />
    <ProjectReference Include="..\OpenDirectoryDownloader.Storage\OpenDirectoryDownloader.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenDirectoryDownloader.Tests" />
  </ItemGroup>

  <!--
    A single file build is one file: the native libraries of the packages (SQLite, HttpCloak) go inside the executable
    as resources, and are only extracted when they are first needed (see Hosting/EmbeddedNativeLibraries.cs).
    Set EmbedNativeLibraries to false to publish them next to the executable instead.
  -->
  <PropertyGroup>
    <EmbedNativeLibraries Condition="'$(EmbedNativeLibraries)' == '' And '$(PublishSingleFile)' == 'true' And '$(RuntimeIdentifier)' != ''">true</EmbedNativeLibraries>
  </PropertyGroup>

  <Target Name="EmbedNativeLibraries" BeforeTargets="PrepareResourceNames" DependsOnTargets="ResolvePackageAssets" Condition="'$(EmbedNativeLibraries)' == 'true'">
    <ItemGroup>
      <_EmbeddedNativeLibrary Include="@(NativeCopyLocalItems)" />
      <EmbeddedResource Include="@(_EmbeddedNativeLibrary)" LogicalName="native/%(Filename)%(Extension)" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveEmbeddedNativeLibrariesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="EmbedNativeLibraries" Condition="'$(EmbedNativeLibraries)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_EmbeddedNativeLibrary)" />
      <!-- The IIS in-process module of the ASP.NET Core runtime pack: the scan viewer runs on Kestrel -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'" />
    </ItemGroup>
  </Target>
</Project>
