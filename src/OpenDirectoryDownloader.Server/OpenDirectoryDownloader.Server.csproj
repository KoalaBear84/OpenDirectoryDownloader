  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenDirectoryDownloader.Tests" />
  </ItemGroup>

</Project>
